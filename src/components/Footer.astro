---
const base = import.meta.env.BASE_URL;
---

<footer class="bg-forest" id="contact">
	<div
		class="mx-auto flex max-w-7xl flex-col gap-10 px-5 py-16 sm:px-8 lg:flex-row lg:items-center lg:justify-between lg:gap-12"
	>
		<div class="flex items-start gap-5">
			<img
				src={`${base}images/tree-of-life.svg`}
				alt=""
				class="hidden h-28 w-auto shrink-0 opacity-90 sm:block"
				width="100"
				height="120"
			/>
			<div>
				<h2 class="font-display text-2xl font-semibold tracking-wide text-gold sm:text-3xl">
					Let's Start With Your Challenge
				</h2>
				<p class="mt-3 max-w-md font-sans text-sm leading-relaxed text-white/80">
					Share the complexity you're navigating. We'll explore how alignment, strategy, and
					human connection can move it forward.
				</p>
				<div class="mt-5 space-y-1.5 font-sans text-sm text-white/85">
					<a class="block transition hover:text-gold" href="mailto:panchalee.connect@gmail.com">
						panchalee.connect@gmail.com
					</a>
					<a class="block transition hover:text-gold" href="https://panchalee.connect">
						panchalee.connect
					</a>
				</div>
			</div>
		</div>

		<a
			href="mailto:hello@panchalee.connect?subject=Strategic%20Discovery%20Call"
			class="inline-flex shrink-0 items-center justify-center gap-2 self-start rounded-sm bg-gold px-6 py-4 font-sans text-sm font-semibold tracking-wide text-forest transition hover:bg-gold-light lg:self-center"
		>
			Book a Strategic Discovery Call
			<span aria-hidden="true">→</span>
		</a>
	</div>

	<div class="border-t border-white/10 px-5 py-5 text-center">
		<p class="font-sans text-xs tracking-wide text-white/50">
			© {new Date().getFullYear()} Panchalee.Connect. All rights reserved.
		</p>
	</div>
</footer>
