---
const base = import.meta.env.BASE_URL;
---

<footer class="bg-forest" id="contact">
    <div
        class="mx-auto flex max-w-7xl flex-col gap-10 px-5 py-16 sm:px-8 lg:flex-row lg:items-center lg:justify-between lg:gap-12"
    >
        <div class="flex items-start gap-5">
            <!-- ส่วนต้นไม้สีทอง พร้อมเอฟเฟกต์แสงวิ่งเฉพาะเนื้อรูป -->
            <div class="tree-container hidden shrink-0 sm:block">
                <img
                    src={`${base}Tree of life.png`}
                    alt="Tree of Life"
                    class="h-28 w-auto opacity-90 tree-image"
                    width="100"
                    height="120"
                />
            </div>
            
            <div>
                <h2 class="font-display text-2xl font-semibold tracking-wide text-gold sm:text-3xl">
                    Let's Start With Your Challenge
                </h2>
                <p class="mt-3 max-w-md font-sans text-sm leading-relaxed text-white/80">
                    Share the complexity you're navigating. We'll explore how alignment, strategy, and human connection can move it forward.
                </p>
                <div class="mt-5 space-y-1.5 font-sans text-sm text-white/85">
                    <a class="block transition hover:text-gold" href="mailto:panchalee.connect@gmail.com">
                        panchalee.connect@gmail.com
                    </a>
                    <a class="block transition hover:text-gold" href="https://panchalee.connect">
                        panchalee.connect
                    </a>
                </div>
            </div>
        </div>

        <a
            href="mailto:hello@panchalee.connect?subject=Strategic%20Discovery%20Call"
            class="inline-flex shrink-0 items-center justify-center gap-2 self-start rounded-sm bg-gold px-6 py-4 font-sans text-sm font-semibold tracking-wide text-forest transition hover:bg-gold-light lg:self-center"
        >
            Book a Strategic Discovery Call
            <span aria-hidden="true">&rarr;</span>
        </a>
    </div>

    <div class="border-t border-white/10 px-5 py-5 text-center">
        <p class="font-sans text-xs tracking-wide text-white/50">
            &copy; {new Date().getFullYear()} Panchalee.Connect. All rights reserved.
        </p>
    </div>
</footer>

<style>
    .tree-container {
        position: relative;
        display: inline-block;
    }

    /* ใช้ Mask เพื่อให้แสงวิ่งอยู่เฉพาะในตัวรูปต้นไม้เท่านั้น ไม่ล้นเป็นกรอบสี่เหลี่ยม */
    .tree-image {
        mask-image: url('/Tree of life.png');
        -webkit-mask-image: url('/Tree of life.png');
        mask-size: contain;
        -webkit-mask-size: contain;
        mask-repeat: no-repeat;
        -webkit-mask-repeat: no-repeat;
        position: relative;
    }

    /* สร้างแสงวิ่งผ่านเนื้อรูปต้นไม้ */
    .tree-container::after {
        content: '';
        position: absolute;
        top: -100%;
        left: 0;
        width: 100%;
        height: 100%;
        background: linear-gradient(
            to top,
            transparent 0%,
            rgba(255, 255, 255, 0.4) 50%,
            transparent 100%
        );
        pointer-events: none;
        animation: tree-sweep 4s infinite ease-in-out;
        /* ใช้ Mask เดียวกันเพื่อให้แสงตัดขอบตามรูปต้นไม้เป๊ะๆ */
        mask-image: url('/Tree of life.png');
        -webkit-mask-image: url('/Tree of life.png');
        mask-size: contain;
        -webkit-mask-size: contain;
        mask-repeat: no-repeat;
        -webkit-mask-repeat: no-repeat;
    }

    @keyframes tree-sweep {
        0% {
            top: 100%;
        }
        50% {
            top: -100%;
        }
        100% {
            top: -100%;
        }
    }
</style>
