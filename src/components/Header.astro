---
const links = [
	{ href: '#expertise', label: 'Expertise' },
	{ href: '#frameworks', label: 'Frameworks' },
	{ href: '#experience', label: 'Experience' },
	{ href: '#about', label: 'About' },
	{ href: '#contact', label: 'Contact' },
];

const base = import.meta.env.BASE_URL;
---

<header class="sticky top-0 z-50 border-b border-white/10 bg-forest/95 backdrop-blur-md">
	<div class="mx-auto flex max-w-7xl items-center justify-between gap-6 px-5 py-3.5 lg:px-8">
		<a href={base} class="group flex shrink-0 items-center gap-3">
			<img src={`${base}P monogram Logo.png`} alt="" class="h-14 w-14" width="56" height="56" />
			<span class="leading-tight">
				<span class="block font-display text-lg font-semibold tracking-wide text-gold sm:text-xl">
					Panchalee.Connect
				</span>
				<span class="hidden text-[10px] tracking-[0.12em] text-white/70 uppercase sm:block">
					Turning Complexity into Action
				</span>
			</span>
		</a>

		<nav class="hidden items-center gap-9 lg:flex" aria-label="Primary">
			{
				links.map((link) => (
					<a
						href={link.href}
						class="font-sans text-[15px] font-medium tracking-wide text-white/85 transition hover:text-gold"
					>
						{link.label}
					</a>
				))
			}
		</nav>

		<a
			href="#contact"
			class="hidden rounded-sm border border-gold px-4 py-2 font-sans text-[15px] font-semibold tracking-wide text-gold transition hover:bg-gold hover:text-forest lg:inline-flex"
		>
			Let's Connect
		</a>

		<details class="group relative lg:hidden">
			<summary
				class="flex cursor-pointer list-none items-center justify-center rounded-sm border border-gold/60 p-2 text-gold [&::-webkit-details-marker]:hidden"
				aria-label="Open menu"
			>
				<svg class="h-5 w-5 group-open:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
					<path d="M4 7h16M4 12h16M4 17h16"></path>
				</svg>
				<svg class="hidden h-5 w-5 group-open:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
					<path d="M6 6l12 12M18 6L6 18"></path>
				</svg>
			</summary>
			<div
				class="absolute right-0 mt-3 w-56 rounded-md border border-white/10 bg-forest-deep p-3 shadow-xl"
			>
				<nav class="flex flex-col gap-1" aria-label="Mobile">
					{
						links.map((link) => (
							<a
								href={link.href}
								class="rounded px-3 py-2.5 font-sans text-sm text-white/90 hover:bg-white/5 hover:text-gold"
							>
								{link.label}
							</a>
						))
					}
					<a
						href="#contact"
						class="mt-2 rounded-sm border border-gold px-3 py-2.5 text-center font-sans text-sm font-semibold text-gold"
					>
						Let's Connect
					</a>
				</nav>
			</div>
		</details>
	</div>
</header>
