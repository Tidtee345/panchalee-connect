---
import SectionHeading from '../SectionHeading.astro';

const base = import.meta.env.BASE_URL;

const challenges = [
  {
    title: 'Multiple stakeholders with competing priorities',
    icon: 'icon-stakeholders.png',
  },
  {
    title: 'Medical societies navigating growth and relevance',
    icon: 'icon-compass.png',
  },
  {
    title: 'Healthcare ecosystems struggling to align on action',
    icon: 'icon-dna.png',
  },
  {
    title: 'Strategies that stall between design and delivery',
    icon: 'icon-compass.png',
  },
  {
    title: 'Public programs needing clarity across agencies',
    icon: 'icon-stakeholders.png',
  },
  {
    title: 'Complex initiatives without shared measures of impact',
    icon: 'icon-target.png',
  },
];
---

<section class="bg-cream px-5 py-20 sm:px-8" id="challenges">
  <div class="mx-auto max-w-7xl">
    <SectionHeading title="The Challenges We Help Solve" />

    <div class="grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16">
      <div>
        <p class="font-sans text-base leading-relaxed text-muted sm:text-lg">
          Complex challenges rarely fail for lack of ideas. They fail when people,
          priorities, and systems cannot move together. We help leaders create the
          clarity, alignment, and momentum that turn intention into coordinated action.
        </p>
      </div>

      <ul class="grid gap-5 sm:grid-cols-2">
        {
          challenges.map((item) => (
            <li class="flex items-start gap-4">
              <img 
                src={`${base}${item.icon}`} 
                alt="" 
                class="h-10 w-10 shrink-0 object-contain" 
              />
              <p class="font-sans text-base leading-relaxed text-forest">
                {item.title}
              </p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
