---
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;

const impacts = [
    {
        title: 'Medical Society Development',
        desc: 'Strengthen relevance, governance, and member value so societies can lead with clarity.',
        icon: `${base}medical-society.png`,
    },
    {
        title: 'Stakeholder Alignment',
        desc: 'Build shared understanding across clinical, policy, industry, and community voices.',
        icon: `${base}stakeholder-alignment.png`,
    },
    {
        title: 'Capability Building',
        desc: 'Equip leaders and teams with the skills to navigate complexity and sustain progress.',
        icon: `${base}capability-building.png`,
    },
    {
        title: 'Impact Measurement',
        desc: 'Define meaningful indicators that connect human outcomes to strategic decisions.',
        icon: `${base}impact-measurement.png`,
    },
];

const worlds = [
    { label: 'Healthcare', icon: base + 'Healthcare.png' },
    { label: 'Public Policy', icon: base + 'PublicPolicy.png' },
    { label: 'Stakeholder Engagement', icon: base + 'StakeholderEngagement.png' },
    { label: 'Medical Societies', icon: base + 'MedicalSocieties.png' },
    { label: 'Human Impact', icon: base + 'HumanImpact.png' },
];
---
<section class="relative overflow-hidden bg-cream" id="about">
	<img
		src={`${base}images/tree-of-life.svg`}
		alt=""
		class="pointer-events-none absolute top-1/2 left-1/2 h-[90%] w-auto -translate-x-1/2 -translate-y-1/2 opacity-[0.06]"
		aria-hidden="true"
	/>

	<div class="relative mx-auto grid max-w-7xl lg:grid-cols-2">
		<div class="py-16 sm:px-6 lg:px-8 text-left pl-2 sm:pl-4 lg:pl-6">
			<h2 class="font-display text-2xl font-semibold tracking-wide text-forest uppercase sm:text-3xl">
				Impact in Action
			</h2>
			<ul class="mt-8 space-y-7">
      {
        impacts.map((item) => (
            <li class="flex items-start gap-5">
                <span class="mt-1 flex h-16 w-16 shrink-0 items-center justify-center">
                    <img src={item.icon} alt={item.title} class="h-full w-full object-contain drop-shadow-md" />
                </span>
                <div>
                    <h3 class="font-display text-lg font-semibold text-forest">{item.title}</h3>
                    <p class="mt-1 font-sans text-sm leading-relaxed text-muted">{item.desc}</p>
                </div>
            </li>
       ))
            }
        </ul>
    </div>
			
		<!-- ฝั่งขวา: What Makes Panchalee.Connect Different -->
    <div class="bg-cream-dark/80 px-5 py-16 sm:px-8 lg:py-20">
        <h2 class="font-display text-2xl font-semibold tracking-wide text-forest uppercase sm:text-3xl">
            What Makes Panchalee.Connect Different
        </h2>
        
        <div class="mt-6 space-y-4 font-sans text-sm leading-relaxed text-muted">
            <p>
                We work at the intersection of systems and people — where strategy meets culture, and where good intentions need structure to become results.
            </p>
            <p>
                Our approach blends healthcare insight, public-policy fluency, and deep stakeholder craft. We do not just advise from the outside; we help create the conditions for alignment and ownership inside the work.
            </p>
            <p>
                The result is practical progress: clearer decisions, stronger coalitions, and impact that can be felt and measured.
            </p>
        </div>

        <div class="mt-8 rounded-xl border border-gold/30 bg-white/50 p-6">
            <p class="font-display text-base font-semibold text-forest mb-4">We bridge five worlds:</p>
            <div class="grid grid-cols-5 gap-4">
                {
                    worlds.map((world) => (
                        <div class="flex flex-col items-center text-center">
                            <div class="flex h-12 w-12 items-center justify-center rounded-full border border-gold/40 bg-white p-2 mb-2 shadow-sm">
                                <img src={world.icon} alt={world.label} class="h-full w-full object-contain" />
                            </div>
                           <span class="font-sans text-[11px] leading-tight font-medium text-ink">{world.label}</span>
                        </div>
                    ))
                }
            </div>
        </div>
    </div>
</section>
