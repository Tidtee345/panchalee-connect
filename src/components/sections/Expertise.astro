---
import SectionHeading from '../SectionHeading.astro';

const base = import.meta.env.BASE_URL;

const expertise = [
	{ label: 'Healthcare Strategy', icon: 'Area-Healthcare-Strategy.png' },
	{ label: 'Stakeholder Engagement', icon: 'Area-Stakeholder-Engagement.png' },
	{ label: 'Medical Society Development', icon: 'Area-Medical-Society-Development.png' },
	{ label: 'Public Affairs', icon: 'Area-Public-Affairs.png' },
	{ label: 'Human Impact Measurement', icon: 'Area-Human-Impact-Measurement.png' },
];

const frameworks = [
	{
		title: 'AI Human Capability Framework™',
		desc: 'A structured way to build human capability alongside AI — so technology strengthens judgment, care, and collaboration.',
		icon: 'dna',
	},
	{
		title: 'AI Human Impact Framework™',
		desc: 'A practical lens for designing and measuring AI initiatives through human outcomes, trust, and system-level value.',
		icon: 'hands',
	},
];
---

<section class="bg-forest px-5 py-20 sm:px-8" id="expertise">
	<div class="mx-auto grid max-w-7xl gap-14 lg:grid-cols-[1.1fr_0.9fr] lg:gap-16">
		<div>
			<SectionHeading title="Areas of Expertise" tone="dark" align="left" class="mb-8 justify-start" />
			<ul class="grid grid-cols-2 gap-6 sm:grid-cols-3 lg:grid-cols-5">
				{
					expertise.map((item) => (
						<li class="flex flex-col items-center gap-3 text-center">
							{/* ลด padding เหลือ p-1 หรือเอาออก แล้วปรับรูปด้านในให้ขยายใหญ่ขึ้น */}
							<span class="flex h-14 w-14 items-center justify-center rounded-full border border-gold/45 p-2 text-gold overflow-hidden">
								<img 
									src={`${base}${item.icon}`} 
									alt={item.label} 
									class="h-full w-full object-contain scale-[2.2]" 
								/>
							</span>
							<span class="font-sans text-xs leading-snug font-medium text-white/90">{item.label}</span>
						</li>
					))
				}
			</ul>
		</div>

		<div id="frameworks">
			<SectionHeading title="Signature Frameworks" tone="dark" align="left" class="mb-8 justify-start" />
			<ul class="space-y-5">
				{
					frameworks.map((item) => (
						<li class="flex gap-4 rounded-sm border border-gold/25 bg-forest-soft/40 p-4 sm:p-5">
							<span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full border border-gold/40 text-gold">
								{item.icon === 'dna' ? (
									<img src={`${base}images/dna.svg`} alt="" class="h-7 w-7 object-contain" />
								) : (
									<svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
										<path d="M8 12c0-3 2-5 4-7 2 2 4 4 4 7a4 4 0 1 1-8 0Z" />
										<path d="M8 12h8" />
										<path d="M10 16c0 2 1 4 2 5 1-1 2-3 2-5" />
									</svg>
								)}
							</span>
							<div>
								<h3 class="font-display text-lg font-semibold text-gold">{item.title}</h3>
								<p class="mt-1.5 font-sans text-sm leading-relaxed text-white/80">{item.desc}</p>
							</div>
						</li>
					))
				}
			</ul>
		</div>
	</div>
</section>
