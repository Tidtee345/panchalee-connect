---
import SectionHeading from '../SectionHeading.astro';

const steps = [
  {
    n: '1',
    title: 'Listen',
    desc: 'Understand context, constraints, and the real human dynamics behind the challenge.',
    icon: '/approach-listen.png', 
  },
  {
    n: '2',
    title: 'Align',
    desc: 'Bring stakeholders to shared purpose, priorities, and a clear problem definition.',
    icon: '/approach-align.png', 
  },
  {
    n: '3',
    title: 'Design',
    desc: 'Shape practical pathways, roles, and decisions that people can act on together.',
    icon: '/approach-design.png', 
  },
  {
    n: '4',
    title: 'Mobilize',
    desc: 'Activate networks, capabilities, and communication to move from plan to progress.',
    icon: '/approach-mobilize.png', 
  },
  {
    n: '5',
    title: 'Sustain',
    desc: 'Embed ownership, learning loops, and measures so impact continues beyond the engagement.',
    icon: '/approach-sustain.png',
  },
];
---

<section class="bg-cream relative overflow-hidden px-5 py-24 sm:px-8" id="approach">
  <div class="mx-auto max-w-7xl">
    <SectionHeading title="OUR ENGAGEMENT APPROACH" />

    <div class="relative mt-16">
      <!-- เส้นเชื่อมสีทอง Gradient ทอดแนวนอน -->
      <div class="absolute top-7 left-[5%] right-[5%] hidden h-[2px] bg-gradient-to-r from-amber-200 via-amber-400 to-amber-200 md:block"></div>

      <ol class="relative grid grid-cols-1 gap-6 sm:grid-cols-2 md:grid-cols-5 md:gap-4">
        {
          steps.map((step) => (
            <li class="group relative flex flex-col items-center rounded-xl border border-amber-200/60 bg-white p-6 pt-8 shadow-sm transition-all duration-300 hover:-translate-y-1.5 hover:border-amber-400 hover:shadow-xl">
              
              <!-- Badge วงกลมตัวเลข 1-5 ด้านบน -->
              <span class="absolute -top-6 flex h-12 w-12 items-center justify-center rounded-full border-2 border-amber-300 bg-forest font-sans text-base font-bold text-gold shadow-md transition-transform duration-300 group-hover:scale-110">
                {step.n}
              </span>

             <div class="mt-2 mb-4 flex h-16 w-16 items-center justify-center">
  <img src={step.icon} alt={step.title} class={`object-contain drop-shadow-md ${step.n === '5' ? 'h-48 w-48 scale-200' : step.n === '1' ? 'h-24 w-24' : 'h-full w-full'}`} />
</div>

              <!-- Title -->
              <h3 class="font-display mb-3 text-center text-lg font-semibold text-forest">
                {step.title}
              </h3>

              <!-- Description -->
              <p class="text-center text-xs leading-relaxed text-gray-600">
                {step.desc}
              </p>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>
