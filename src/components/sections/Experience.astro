---
import SectionHeading from '../SectionHeading.astro';

const base = import.meta.env.BASE_URL;

const experiences = [
	{ label: 'Healthcare Industry', icon: 'Experience-Healthcare-Industry.png' },
	{ label: 'Rare Diseases', icon: 'Experience-Rare-Diseases.png' },
	{ label: 'Medical Societies', icon: 'Experience-Medical-Societies.png' },
	{ label: 'Public Affairs', icon: 'Experience-Public-Affairs.png' },
	{ label: 'Patient Advocacy', icon: 'Experience-Patient-Advocacy.png' },
	{ label: 'Regional & International Networks', icon: 'Experience-Regional-International-Networks.png' },
	{ label: 'Public–Private Partnerships', icon: 'Experience-Public-Private-Partnerships.png' },
];
---

<section class="bg-cream px-4 py-20 sm:px-6 lg:px-8" id="experience">
	<div class="mx-auto max-w-7xl">
		<SectionHeading title="Selected Experience" />

		<ul class="grid grid-cols-2 gap-x-6 gap-y-12 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-7 items-start">
			{
				experiences.map((item) => (
					<li class="flex flex-col items-center text-center">
						<!-- ตรงนี้คือ div ที่ครอบไอคอนครับ ปรับขนาดตรงนี้ -->
						<!-- กำหนดความกว้าง-สูงให้เท่ากันทุกอัน เช่น h-28 w-28 -->
						<div class="flex h-28 w-28 items-center justify-center">
							<img 
								src={`${base}${item.icon.startsWith('/') ? item.icon.slice(1) : item.icon}`} 
								alt={item.label} 
								<!-- ปรับให้รูปภาพขยายเต็มกรอบด้วย h-full w-full object-contain -->
								class="h-full w-full object-contain" 
							/>
						</div>
						<!-- ปรับระยะห่างเล็กน้อย mt-6 และขนาดตัวอักษร -->
						<span class="mt-6 w-40 font-sans text-xs sm:text-sm leading-snug font-medium text-ink">
							{item.label}
						</span>
					</li>
				))
			}
		</ul>
	</div>
</section>
