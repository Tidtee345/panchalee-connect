---
---

<section class="relative overflow-hidden bg-forest">
	<div class="pointer-events-none absolute inset-0" aria-hidden="true">
		<img
			src="/images/tree-of-life.svg"
			alt=""
			class="absolute top-1/2 left-[42%] hidden h-[120%] w-auto -translate-y-1/2 opacity-40 lg:block"
		/>
		<img
			src="/images/dna.svg"
			alt=""
			class="absolute top-8 right-4 hidden h-[85%] w-auto opacity-30 xl:block"
		/>
		<div
			class="absolute inset-0 bg-[radial-gradient(ellipse_at_70%_40%,rgba(197,163,88,0.12),transparent_55%)]"
		>
		</div>
	</div>

	<div
		class="relative mx-auto grid max-w-7xl items-center gap-10 px-5 py-16 sm:px-8 lg:grid-cols-[1.05fr_0.95fr] lg:gap-8 lg:py-20"
	>
		<div class="max-w-xl">
			<h1
				class="font-display text-4xl leading-[1.08] font-bold tracking-wide text-gold uppercase sm:text-5xl lg:text-[3.25rem]"
			>
				Turning Complexity<br class="hidden sm:block" /> into Action
			</h1>
			<p class="mt-6 font-sans text-base leading-relaxed text-white/85 sm:text-lg">
				Panchalee.Connect helps healthcare organizations, medical societies, and public
				institutions align stakeholders, clarify strategy, and turn complex challenges into
				coordinated, measurable impact.
			</p>
			<div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
				<a
					href="#contact"
					class="inline-flex items-center justify-center gap-2 rounded-sm bg-gold px-5 py-3.5 font-sans text-sm font-semibold tracking-wide text-forest transition hover:bg-gold-light"
				>
					Let's Start With Your Challenge
					<span aria-hidden="true">→</span>
				</a>
				<a
					href="#expertise"
					class="inline-flex items-center justify-center rounded-sm border border-gold px-5 py-3.5 font-sans text-sm font-semibold tracking-wide text-gold transition hover:bg-gold/10"
				>
					Explore Our Expertise
				</a>
			</div>
		</div>

		<div class="relative mx-auto w-full max-w-md lg:max-w-none">
			<div class="relative aspect-[4/5] overflow-hidden rounded-sm sm:aspect-[5/6]">
				<img
					src="/images/portrait.png"
					alt="Panchalee — founder of Panchalee.Connect"
					class="h-full w-full object-cover object-top"
					width="800"
					height="1000"
				/>
				<div
					class="absolute inset-0 bg-gradient-to-t from-forest via-transparent to-transparent opacity-70"
				>
				</div>
				<div
					class="absolute inset-0 bg-gradient-to-l from-forest/40 via-transparent to-transparent"
				>
				</div>
			</div>

			<blockquote
				class="absolute right-0 bottom-6 left-0 mx-4 rounded-sm border border-gold/30 bg-forest/80 p-5 backdrop-blur-sm sm:left-auto sm:max-w-xs"
			>
				<p
					class="font-display text-lg leading-snug text-gold italic sm:text-xl"
				>
					<span class="mr-1 text-3xl leading-none text-gold/70">“</span>
					Connection creates alignment. Alignment drives impact.
					<span class="ml-1 text-3xl leading-none text-gold/70">”</span>
				</p>
			</blockquote>
		</div>
	</div>
</section>
