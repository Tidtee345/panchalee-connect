---
const base = import.meta.env.BASE_URL;
---

<section class="relative overflow-hidden bg-forest">
    <!-- ภาพพื้นหลัง (คงความสวยงามเต็มจอ) -->
    <div
        class="relative lg:absolute lg:inset-0 w-full h-[320px] sm:h-[400px] lg:h-full pointer-events-none mt-8 lg:mt-0"
        aria-hidden="true"
    >
        <img
            src={`${base}images/hero-bg-portrait.png`}
            alt="Panchalee Connect"
            class="h-full w-full object-cover object-[70%_center] lg:object-right"
        />
        
        <!-- **ส่วนเพิ่มเอฟเฟกต์แสง Node กะพริบ** -->
        <div class="absolute inset-0 w-full h-full overflow-hidden">
            <!-- สร้างจุดแสงหลายๆ จุด กระจายตามตำแหน่งที่เหมาะสมบนต้นไม้ -->
            <div class="node-light animate-node-pulse" style="top: 45%; left: 78%; animation-delay: 0.2s;"></div>
            <div class="node-light animate-node-pulse" style="top: 52%; left: 85%; animation-delay: 1.5s;"></div>
            <div class="node-light animate-node-pulse" style="top: 40%; left: 92%; animation-delay: 0.7s;"></div>
            <div class="node-light animate-node-pulse" style="top: 65%; left: 88%; animation-delay: 2.1s;"></div>
            <div class="node-light animate-node-pulse" style="top: 75%; left: 95%; animation-delay: 1.1s;"></div>
            <!-- สามารถเพิ่มจุดแสงอื่นๆ ตามต้องการ โดยก๊อปปี้บรรทัดด้านบนและเปลี่ยน top, left, animation-delay -->
        </div>
    </div>

    <!-- ส่วนเนื้อหาและข้อความ -->
    <div
        class="relative z-10 grid min-h-[550px] lg:min-h-[600px] w-full items-center gap-10 px-6 py-12 sm:px-12 lg:grid-cols-[1.1fr_0.9fr] lg:gap-4 lg:py-24 lg:pl-16 xl:pl-24"
    >
        <div class="max-w-xl pt-0 lg:pt-0">
            <h1
                class="font-display text-4xl leading-[1.08] font-bold tracking-wide text-gold uppercase sm:text-5xl lg:text-[3.25rem]"
            >
                Turning Complexity<br class="hidden sm:block" /> into Action
            </h1>
            <p class="mt-6 font-sans text-base leading-relaxed text-white sm:text-lg">
                Panchalee.Connect helps healthcare organizations, professional
                societies, and public-sector stakeholders align people, systems
                and strategy to create measurable impact.
            </p>
            <p class="mt-4 font-sans text-sm leading-relaxed text-white sm:text-base">
                When important initiatives involve multiple stakeholders, competing
                priorities and complex systems, Panchalee.Connect creates clarity,
                alignment and execution.
            </p>
            <div class="mt-12 flex flex-col gap-3 sm:flex-row sm:items-center">
                <a
                    href="#contact"
                    class="inline-flex items-center justify-center gap-2 rounded-sm bg-gold px-5 py-3.5 font-sans text-sm font-semibold tracking-wide text-forest transition hover:bg-gold-light"
                >
                    Let's Start With Your Challenge
                    <span aria-hidden="true">&rarr;</span>
                </a>
                <a
                    href="#expertise"
                    class="inline-flex items-center justify-center gap-2 rounded-sm border border-gold px-5 py-3.5 font-sans text-sm font-semibold tracking-wide text-gold transition hover:bg-gold/10"
                >
                    Explore Our Expertise
                </a>
            </div>
        </div>
    </div>
</section>

<!-- ส่วนเพิ่ม Style ของ Node Light และ Animation Keyframes -->
<style>
    /* สไตล์ของจุดแสง (Node) */
    .node-light {
        position: absolute;
        width: 8px; /* ขนาดของ Node */
        height: 8px;
        background-color: #f7e080; /* สีทองอ่อนๆ เข้ากับธีม */
        border-radius: 50%; /* ทำให้เป็นวงกลม */
        box-shadow: 0 0 8px 2px #f7e080; /* ใส่แสง Glow รอบๆ */
        opacity: 0; /* เริ่มต้นซ่อนไว้ */
    }

    /* กำหนด Keyframe สำหรับการกะพริบแบบ Pulse (วาบขึ้นแล้วจางลง) */
    @keyframes node-pulse {
        0% { opacity: 0.3; transform: scale(0.8); }
        50% { opacity: 1; transform: scale(1.2); } /* สว่างวาบและขยายใหญ่ขึ้นเล็กน้อย */
        100% { opacity: 0.3; transform: scale(0.8); }
    }

    /* คลาสเรียกใช้ Animation */
    .animate-node-pulse {
        animation: node-pulse 3s infinite ease-in-out; /* ปรับความเร็วได้ตรงนี้ 3s คือค่อยๆ กระพริบช้าๆ */
    }
</style>
