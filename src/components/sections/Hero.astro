---
const base = import.meta.env.BASE_URL;
---

<section class="relative overflow-hidden bg-forest">
	<div class="pointer-events-none absolute inset-0" aria-hidden="true">
		<img
			src={`${base}images/dna.svg`}
			alt=""
			class="absolute top-8 right-4 hidden h-[85%] w-auto opacity-30 xl:block"
		/>
		<div
			class="absolute inset-0 bg-[radial-gradient(ellipse_at_72%_42%,rgba(197,163,88,0.14),transparent_52%)]"
		>
		</div>
	</div>

	<div
		class="relative mx-auto grid max-w-7xl items-center gap-10 px-5 py-16 sm:px-8 lg:grid-cols-[1.05fr_0.95fr] lg:gap-4 lg:py-20"
	>
		<div class="max-w-xl">
			<h1
				class="font-display text-4xl leading-[1.08] font-bold tracking-wide text-gold uppercase sm:text-5xl lg:text-[3.25rem]"
			>
				Turning Complexity<br class="hidden sm:block" /> into Action
			</h1>
			<p class="mt-6 font-sans text-base leading-relaxed text-white/85 sm:text-lg">
				Panchalee.Connect helps healthcare organizations, medical societies, and public
				institutions align stakeholders, clarify strategy, and turn complex challenges into
				coordinated, measurable impact.
			</p>
			<div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
				<a
					href="#contact"
					class="inline-flex items-center justify-center gap-2 rounded-sm bg-gold px-5 py-3.5 font-sans text-sm font-semibold tracking-wide text-forest transition hover:bg-gold-light"
				>
					Let's Start With Your Challenge
					<span aria-hidden="true">→</span>
				</a>
				<a
					href="#expertise"
					class="inline-flex items-center justify-center rounded-sm border border-gold px-5 py-3.5 font-sans text-sm font-semibold tracking-wide text-gold transition hover:bg-gold/10"
				>
					Explore Our Expertise
				</a>
			</div>
		</div>

		<div class="relative mx-auto w-full max-w-md lg:max-w-none">
			<div class="relative h-[20rem] overflow-visible sm:h-[24rem] lg:h-[28rem]">
				<img
					src={`${base}images/hero-bg-tree.png`}
					alt=""
					class="hero-scene absolute inset-0 h-full w-full object-cover object-[center_42%]"
					width="1536"
					height="1024"
					aria-hidden="true"
				/>
				<img
					src={`${base}images/panchalee-portrait.png`}
					alt="Panchalee — founder of Panchalee.Connect"
					class="hero-portrait absolute right-[-8%] bottom-0 z-10 h-[78%] w-auto max-w-[62%] object-contain object-right-bottom lg:right-[-10%] lg:h-[82%]"
					width="500"
					height="500"
				/>
				<!-- Soft edge blend into forest so neither scene nor portrait reads as a card -->
				<div
					class="pointer-events-none absolute inset-x-0 bottom-0 z-20 h-28 bg-gradient-to-t from-forest via-forest/80 to-transparent"
				>
				</div>
				<div
					class="pointer-events-none absolute inset-y-0 left-0 z-20 w-24 bg-gradient-to-r from-forest to-transparent"
				>
				</div>
			</div>

			<blockquote
				class="absolute bottom-6 left-4 z-30 max-w-xs rounded-sm border border-gold/30 bg-forest/75 p-5 backdrop-blur-sm"
			>
				<p
					class="font-display text-lg leading-snug text-gold italic sm:text-xl"
				>
					<span class="mr-1 text-3xl leading-none text-gold/70">“</span>
					Connection creates alignment. Alignment drives impact.
					<span class="ml-1 text-3xl leading-none text-gold/70">”</span>
				</p>
			</blockquote>
		</div>
	</div>
</section>

<style>
	.hero-scene {
		-webkit-mask-image: radial-gradient(ellipse 78% 88% at 58% 48%, #000 38%, transparent 76%);
		mask-image: radial-gradient(ellipse 78% 88% at 58% 48%, #000 38%, transparent 76%);
	}

	.hero-portrait {
		filter: contrast(1.14) saturate(1.08) brightness(1.05);
		-webkit-mask-image:
			linear-gradient(to top, transparent 0%, #000 16%, #000 90%, transparent 100%),
			linear-gradient(to left, transparent 0%, #000 12%, #000 100%);
		mask-image:
			linear-gradient(to top, transparent 0%, #000 16%, #000 90%, transparent 100%),
			linear-gradient(to left, transparent 0%, #000 12%, #000 100%);
		-webkit-mask-composite: source-in;
		mask-composite: intersect;
	}
</style>
